# URL do Main-Server (backend compartilhado). Sem valor, usa o padrão local
# em src/lib/main-server.ts (http://127.0.0.1:8000).
VITE_MAIN_SERVER_URL=http://127.0.0.1:8000

# Opcional: libera os controles de admin (modelo, effort, verbosity, vector
# store, max tokens) num BUILD específico, sem depender de localhost. No
# `npm run dev` o admin já vem ligado e esta variável é irrelevante.
VITE_ACCESS_LEVEL=0

# Módulo AGENT (ações sugeridas). 0 = desligado, 1 = ligado.
# Ligado, o ConsBOT mostra botões opcionais quando a pergunta casa com alguma
# regra de src/lib/agent/rules.ts (ex.: pedido de busca literal → abre a busca
# em livros do Cons-ia.org). Não altera prompt, payload nem resposta da LLM.
#
# NÃO É PRECISO DEFINIR PARA DESENVOLVER: `npm run dev` já liga sozinho, igual
# ao ACCESS_LEVEL. Defina esta variável só para forçar o contrário do padrão —
# =0 para conferir o comportamento normal no dev, =1 para ligar num build.
# VITE_AGENT_MODE=1

# Opcional: sobrescreve as URLs dos módulos externos abertos pelo modo agente.
# Os padrões estão em src/lib/agent/config.ts (AGENT_TARGETS).
# VITE_SEARCH_BOOK_URL=https://cons-ia.org/index_search_book.html
# VITE_SEARCH_VERBETE_URL=https://cons-ia.org/index_search_verb.html
# VITE_BIBLIOGRAPHY_URL=https://cons-ia.org/index_biblio_wv.html
# VITE_BIBLIOGRAPHY_VERBETE_URL=https://cons-ia.org/index_biblio_verbete.html
# VITE_LEXICONS_URL=https://lexicons.cons-ia.org/
